# Entry point for the Pico 2 kernel driving 3x 20x4 LCD panels.
#
# This is a thin wrapper: kernel/boot.deor brings in the crate preamble
# and hardware bring-up (kernel/kernel.rs), application/app.deor holds the
# sequencing of what actually gets shown. This file just wires the real
# hardware entry point: bring up hardware, then hand off to app_main().

import "kernel/boot.deor"
import "application/app.deor"

rust
    #[entry]
    fn main() -> ! {
        hw_init();
        app_main();
        loop {
            cortex_m::asm::wfi();
        }
    }
