# User-space: sequencing what gets shown on the three panels.

import "lib/lcd.deor"

fn void app_main()
    int panel1 = 1
    string greeting1 = "hello 1"
    xl_print(panel1, greeting1)

    int panel2 = 2
    string greeting2 = "hello 3"
    xl_print(panel2, greeting2)

    int panel3 = 3
    string greeting3 = "hello 3"
    xl_print(panel3, greeting3)
