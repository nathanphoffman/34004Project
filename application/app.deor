# User-space: sequencing what gets shown on the three panels, then
# echoing keystrokes from lib/keyboard.deor onto panel 1. Real hardware
# reads a PS/2 keyboard via an interrupt; the Wokwi build gets the same
# characters from kernel/keyboard_sim.rs's polled injector instead —
# this file can't tell the difference either way, and wait_for_interrupt()
# below is real sleep on real hardware but a no-op on Wokwi (see
# kernel/keyboard.rs for why Wokwi doesn't use interrupts) — same call,
# different Rust underneath depending on which is being built.

import "lib/lcd.deor"
import "lib/keyboard.deor"
import "lib/string.deor"

fn void wait_for_interrupt()
    rust
        kernel_idle();

fn bool batch_reached(int count)
    rust
        display_batch_reached(count)

fn void app_main()
    int panel1 = 1
    string greeting1 = "rebuild check 1"
    xl_print(panel1, greeting1)

    int panel2 = 2
    string greeting2 = "rebuild check 2"
    xl_print(panel2, greeting2)

    int panel3 = 3
    string greeting3 = "rebuild check 3"
    xl_print(panel3, greeting3)

    string typed = ""
    int since_flush = 0
    for if true
        wait_for_interrupt()
        string key = xk_read_key()
        if key is not ""
            typed = s_join([typed, key])
            since_flush = since_flush + 1
            if batch_reached(since_flush) or key is "\n"
                xl_print(panel1, typed)
                since_flush = 0
